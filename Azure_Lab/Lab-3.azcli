# Lab -3
# Attach and Mount Azure Disk Storage to VM
# Scenario:
# You need persistent storage for logs generated by an Ubuntu VM.
# Tasks:
# Create a managed disk (Standard HDD, 128GB)
# Attach disk to UbuntuVM
# On VM:
# Partition, format (ext4), and mount at /mnt/logs
# Add to /etc/fstab for auto-mount
# Verify:
# Write a test log file
# Reboot and confirm mount persists
# ____________________________________________________________

# Ans:
# Create Resource Group
az group create --name TestRG --location eastus

# {
#   "id": "/subscriptions/f7db2ee6-052c-459f-9a5c-3ccf3d9f06dd/resourceGroups/TestRG",
#   "location": "eastus",
#   "managedBy": null,
#   "name": "TestRG",
#   "properties": {
#     "provisioningState": "Succeeded"
#   },
#   "tags": null,
#   "type": "Microsoft.Resources/resourceGroups"
# }

# Create Ubuntu VM
az vm create --resource-group TestRG --name linuxVM --image Ubuntu2204 --admin-username azureuser --generate-ssh-keys --size Standard_B1s

# The default value of '--size' will be changed to 'Standard_D2s_v5' from 'Standard_DS1_v2' in a future release.
# {
#   "fqdns": "",
#   "id": "/subscriptions/f7db2ee6-052c-459f-9a5c-3ccf3d9f06dd/resourceGroups/TestRG/providers/Microsoft.Compute/virtualMachines/linuxVM",
#   "location": "eastus",
#   "macAddress": "7C-1E-52-1B-68-DD",
#   "powerState": "VM running",
#   "privateIpAddress": "10.0.0.4",
#   "publicIpAddress": "172.173.207.190",
#   "resourceGroup": "TestRG",
#   "zones": ""
# }


# Create 128GB Standard HDD Managed Disk. attach to VM
az disk create --resource-group TestRG --name linuxVM-Logs-Disk --size-gb 128 --sku Standard_LRS --location eastus

# {
#   "creationData": {
#     "createOption": "Empty"
#   },
#   "diskIOPSReadWrite": 500,
#   "diskMBpsReadWrite": 60,
#   "diskSizeBytes": 137438953472,
#   "diskSizeGB": 128,
#   "diskState": "Unattached",
#   "encryption": {
#     "type": "EncryptionAtRestWithPlatformKey"
#   },
#   "id": "/subscriptions/f7db2ee6-052c-459f-9a5c-3ccf3d9f06dd/resourceGroups/TestRG/providers/Microsoft.Compute/disks/linuxVM-Logs-Disk",
#   "location": "eastus",
#   "name": "linuxVM-Logs-Disk",
#   "networkAccessPolicy": "AllowAll",
#   "provisioningState": "Succeeded",
#   "publicNetworkAccess": "Enabled",
#   "resourceGroup": "TestRG",
#   "sku": {
#     "name": "Standard_LRS",
#     "tier": "Standard"
#   },
#   "tags": {},
#   "timeCreated": "2025-07-03T17:18:12.461162+00:00",
#   "type": "Microsoft.Compute/disks",
#   "uniqueId": "7718bde6-3ea2-4a31-896e-c91e5b3793ec"
# }


# Attach The disk to VM
az vm disk attach --resource-group TestRG --vm-name linuxVM --name linuxVM-Logs-Disk

# SSH into the VM  # Public addresh 
ssh azureuser@172.173.207.190

# After Connect azureuser@linuxVM:~$

# Become root user (optional but useful)
sudo -s
# After root user - root@linuxVM:/home/azureuser#


# List block devices to identify new disk (usually /dev/sdc)
lsblk



# Partition the new disk /dev/sdc
fdisk /dev/sdc
# Inside fdisk:
# n (new partition)
# p (primary)
# 1 (partition number)
# accept default first sector (press Enter)
# accept default last sector (press Enter)
# p (print partition table to verify)
# w (write and exit)

# Check partition created
lsblk

# root@linuxVM:/home/azureuser# lsblk
# NAME    MAJ:MIN RM  SIZE RO TYPE MOUNTPOINTS
# loop0     7:0    0 63.8M  1 loop /snap/core20/2599
# loop1     7:1    0 89.4M  1 loop /snap/lxd/31333
# loop2     7:2    0 50.9M  1 loop /snap/snapd/24671
# sda       8:0    0   30G  0 disk
# ├─sda1    8:1    0 29.9G  0 part /
# ├─sda14   8:14   0    4M  0 part
# └─sda15   8:15   0  106M  0 part /boot/efi
# sdb       8:16   0    4G  0 disk
# └─sdb1    8:17   0    4G  0 part /mnt
# sdc       8:32   0  128G  0 disk
# sr0      11:0    1  628K  0 rom

# Format the partition with ext4 filesystem
mkfs.ext4 /dev/sdc

# Allocating group tables: done
# Writing inode tables: done
# Creating journal (262144 blocks): done
# Writing superblocks and filesystem accounting information: done

# Create mount point directory
mkdir -p /mnt/logs

# Mount the partition
mount /dev/sdc1 /mnt/logs

# Check mounted partitions
df -h

# Filesystem      Size  Used Avail Use% Mounted on
# /dev/root        29G  1.6G   28G   6% /
# tmpfs           425M     0  425M   0% /dev/shm
# tmpfs           170M  968K  169M   1% /run
# tmpfs           5.0M     0  5.0M   0% /run/lock
# efivarfs        128K   39K   85K  32% /sys/firmware/efi/efivars
# /dev/sda15      105M  6.1M   99M   6% /boot/efi
# /dev/sdb1       3.9G   36K  3.7G   1% /mnt
# /dev/sdc1       126G   28K  120G   1% /mnt/logs
# tmpfs            85M  4.0K   85M   1% /run/user/1000

# Get the UUID of the new partition for fstab
blkid /dev/sdc1

# /dev/sdc1: UUID="8714a0c1-9863-43f7-8c52-a24e7e9fe452" BLOCK_SIZE="4096" TYPE="ext4" PARTUUID="a328ebca-01"

# Edit /etc/fstab to add the mount entry (replace <UUID> with actual value)
# Example line to add:
# UUID=f3852029-a0f1-4f42-a42c-23459edc8121 /mnt/logs ext4 defaults 0 0
vi /etc/fstab

# CLOUD_IMG: This file was created/modified by the Cloud Image build process
# UUID=16eafc62-add0-41ec-94cc-89918be81d72       /        ext4   discard,errors=remount-ro       0 1
# UUID=3565-1DF6  /boot/efi       vfat    umask=0077      0 1
# /dev/disk/cloud/azure_resource-part1    /mnt    auto    defaults,nofail,x-systemd.after=cloud-init.service,_netdev,comment=cloudconfig  0       2
# UUID=8714a0c1-9863-43f7-8c52-a24e7e9fe452 /mnt/logs ext4 defaults 0 0

# Test mount all fstab entries without reboot
mount -a

# Confirm mount is persistent and active
lsblk
df -h

# Write a test log file
echo "Do Some pratice on Disk" | sudo tee /mnt/logs/test.log

# Do Some pratice on Disk

# Verify file content
cat /mnt/logs/test.log
# Do Some pratice on Disk


# Reboot the VM to verify persistence
sudo reboot

# After reboot, SSH back and verify mount
ssh azureuser@172.173.207.190
df -h | grep /mnt/logs
cat /mnt/logs/test.log

# Show the total size of disk
df -h --total | grep total

clear